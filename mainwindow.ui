QWidget
{
    background-color: #181818;
    color: #ffffff;
    font-size: 14px;
    font-family: Segoe UI;
}

QPushButton
{
    background-color: #3b82f6;
    border: none;
    border-radius: 12px;
    padding: 10px;
    min-height: 20px;

    color: white;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover
{
    background-color: #2563eb;
}

QPushButton:pressed
{
    background-color: #1d4ed8;
}

QLineEdit
{
    background-color: #262626;

    border: 2px solid #404040;

    border-radius: 10px;

    padding: 8px;

    color: white;

    selection-background-color: #3b82f6;
}

QLineEdit:focus
{
    border: 2px solid #3b82f6;
}

QLabel
{
    color: white;
    font-size: 15px;
}

QTableWidget
{
    background-color: #202020;

    alternate-background-color: #262626;

    border: 1px solid #404040;

    gridline-color: #404040;

    border-radius: 12px;

    color: white;

    selection-background-color: #3b82f6;
}

QTableWidget::item
{
    padding: 6px;
}

QHeaderView::section
{
    background-color: #2d2d2d;

    color: white;

    padding: 10px;

    border: 1px solid #404040;

    font-weight: bold;
}

QListWidget
{
    background-color: #202020;

    border: 1px solid #404040;

    border-radius: 12px;

    padding: 8px;

    color: white;

    font-size: 15px;
}

QListWidget::item
{
    padding: 12px;

    border-radius: 8px;
}

QListWidget::item:selected
{
    background-color: #3b82f6;
}

QScrollBar:vertical
{
    background: #202020;

    width: 14px;

    margin: 0px;
}

QScrollBar::handle:vertical
{
    background: #404040;

    min-height: 30px;

    border-radius: 7px;
}

QScrollBar::handle:vertical:hover
{
    background: #555555;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical
{
    height: 0px;
}</string>
